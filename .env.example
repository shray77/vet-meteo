# Пример переменных окружения (скопировать в .env; всё — опционально).
# Репо без БД: Prisma/DATABASE_URL не используется — пример ниже писался по шаблону.

# Сайт: база «АРХИВА Actions» (raw GitHub), по умолчанию — само репо vet-meteo
# NEXT_PUBLIC_ARCHIVE_BASE=https://raw.githubusercontent.com/shray77/vet-meteo/main

# Конвейер: адрес CF Worker vet-api для среза станций (tools/cf-slice.mjs);
# не задан — stations.yml считает локально через tools/fetch_stations.mjs
# VET_API_URL=https://vet-api.<account>.workers.dev

# Telegram-алерты и дайджесты (tools/alerts.mjs, weekly.mjs, daily-outlook.yml)
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# OSINT-выгрузка открытых MQTT-брокеров (tools/osint_cli.py)
# SHODAN_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=
